name: Build installers
on:
  workflow_dispatch:
  push:
    tags: ["v*"]
jobs:
  windows:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.11" }
      - run: python -m pip install -r requirements.txt
      - run: python build.py
      - name: Bundle Tesseract OCR
        shell: pwsh
        run: |
          choco install tesseract -y --no-progress
          Copy-Item "C:\Program Files\Tesseract-OCR" -Destination tesseract -Recurse
      - run: choco install innosetup -y --no-progress
      - run: '& "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" installer.iss'
      - uses: actions/upload-artifact@v4
        with: { name: PDFToolkit-Windows-Setup, path: installer/PDFToolkit-Setup.exe }
  android:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Check Android project files
        run: |
          for f in android/settings.gradle.kts android/build.gradle.kts android/app/build.gradle.kts android/app/src/main/AndroidManifest.xml android/app/src/main/java/com/pdftoolkit/app/MainActivity.kt android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.png; do
            [ -f "$f" ] || { echo "::error::Missing file in repository: $f (upload the android folder with all its subfolders)"; exit 1; }
          done
      - uses: actions/setup-java@v5
        with: { distribution: temurin, java-version: "17" }
      - name: Accept Android SDK licenses (SDK is preinstalled on the runner)
        run: |
          SDKM=$(ls -d "$ANDROID_HOME"/cmdline-tools/*/bin/sdkmanager | head -1)
          yes | "$SDKM" --licenses > /dev/null || true
      - uses: gradle/actions/setup-gradle@v4
        with: { gradle-version: "8.7" }
      - name: Build APK (retries on network hiccups)
        run: |
          for i in 1 2 3; do
            gradle -p android assembleDebug --no-daemon --refresh-dependencies && exit 0
            echo "Attempt $i failed, retrying..."; sleep 20
          done
          exit 1
      - uses: actions/upload-artifact@v4
        with: { name: PDFToolkit-Android-APK, path: android/app/build/outputs/apk/debug/app-debug.apk }
